<Page x:Class="ChudoObuv.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="Calibri" FontSize="16" Background="{StaticResource MainBackgroundBrush}"
      Title="Оформление заказа"
      Loaded="Page_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="ClientText" FontSize="18" Margin="4" TextWrapping="Wrap" />
        <DataGrid Grid.Row="1" x:Name="ItemsDataGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*" />
                <DataGridTextColumn Header="Производство" Binding="{Binding Manufacturer}" Width="170" />
                <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="80" />
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="100" />
                <DataGridTextColumn Header="Цена за ед., ₽" Binding="{Binding UnitPrice, StringFormat=N2}" Width="120" />
                <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Sum, StringFormat=N2}" Width="120" />
                <DataGridTemplateColumn Header="" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Удалить" Margin="2" Padding="6,0" MinHeight="26" Click="RemoveItemButton_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" x:Name="TotalText" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" Margin="4,8" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Продолжить выбор товаров" Click="ContinueButton_Click" />
            <Button Content="Отказаться от заказа" Click="CancelOrderButton_Click" />
            <Button Content="Подтвердить заказ" Style="{StaticResource AccentButton}" Click="ConfirmButton_Click" />
        </StackPanel>
    </Grid>
</Page>
