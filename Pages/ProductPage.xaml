<Page x:Class="ChudoObuv.Pages.ProductPage" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      FontFamily="Calibri" 
      FontSize="16" 
      Background="{StaticResource MainBackgroundBrush}" 
      Loaded="Page_Loaded">


    <Page.Title>Просмотр товара</Page.Title>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: Изображение -->
            <Border Grid.Column="0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="8" VerticalAlignment="Top">
                <Image x:Name="ProductImage" Height="280" Stretch="Uniform" />
            </Border>

            <!-- Правая колонка: Информация -->
            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                <TextBlock x:Name="NameText" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" />

                <TextBlock Margin="0,6,0,0">
                    <Run FontWeight="Bold">Производство:</Run> <Run x:Name="ManufacturerRun" />
                </TextBlock>

                <TextBlock>
                    <Run FontWeight="Bold">Категория:</Run> <Run x:Name="CategoryRun" />
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,6">
                    <TextBlock FontWeight="Bold" VerticalAlignment="Center">Цена со скидкой:</TextBlock>
                    <TextBlock x:Name="DiscountedPriceText" FontSize="24" FontWeight="Bold" Margin="8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="OldPriceText" TextDecorations="Strikethrough" Foreground="DimGray" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="Bold">Состав:</Run> <Run x:Name="CompositionRun" />
                </TextBlock>

                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0">
                    <Run FontWeight="Bold">Описание:</Run> <Run x:Name="DescriptionRun" />
                </TextBlock>

                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0">
                    <Run FontWeight="Bold">Размерный ряд:</Run> <Run x:Name="SizeRangeRun" />
                </TextBlock>

                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="Bold">Доступные для заказа размеры:</Run> <Run x:Name="AvailableSizesRun" />
                </TextBlock>

                <!-- Блок заказа -->
                <Border Background="{StaticResource SecondaryBackgroundBrush}" Padding="12" Margin="0,16,0,0" CornerRadius="6">
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="Bold">Добавление в заказ</TextBlock>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center">Размер:</TextBlock>
                            <ComboBox Grid.Column="1" x:Name="SizeComboBox" DisplayMemberPath="SizeText" SelectionChanged="SizeComboBox_SelectionChanged" />

                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">Количество:</TextBlock>
                            <TextBox Grid.Column="3" x:Name="QuantityTextBox" Text="1" MaxLength="3" PreviewTextInput="QuantityTextBox_PreviewTextInput" ToolTip="Введите целое число пар от 1 до доступного количества" />

                            <TextBlock Grid.Column="4" x:Name="AvailableText" VerticalAlignment="Center" Margin="8,0" Foreground="DimGray" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Добавить в заказ" Style="{StaticResource AccentButton}" Click="AddButton_Click" />
                            <Button Content="Перейти к оформлению заказа" Click="CartButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
