<Page x:Class="ChudoObuv.Pages.OrderPage" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      FontFamily="Calibri" FontSize="16" Background="{StaticResource MainBackgroundBrush}" 
      Title="Состав заказа" 
      Loaded="Page_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText" FontSize="20" FontWeight="Bold" Margin="4" 
TextWrapping="Wrap" />

        
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="Дата заказа:" VerticalAlignment="Center" Margin="4,0" />
            <TextBlock x:Name="OrderDateText" VerticalAlignment="Center" FontWeight="Bold" />
            <!-- Редактирование даты доступно только администратору -->
            <DatePicker x:Name="OrderDatePicker" Width="160" Margin="4" FontSize="16" />
            <Button x:Name="SaveDateButton" Content="Сохранить дату" Style="{StaticResource 
AccentButton}" Click="SaveDateButton_Click" />
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="ItemsDataGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товарная позиция (модель, производство, размер)" 
Binding="{Binding Position}" Width="*" />
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="110" />
                <DataGridTextColumn Header="Цена за ед., ₽" Binding="{Binding UnitPrice, 
StringFormat=N2}" Width="130" />
                <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Sum, StringFormat=N2}" 
Width="130" />
                <DataGridTemplateColumn x:Name="DeleteColumn" Header="" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Удалить позицию" Margin="2" Padding="6,0" MinHeight="26" 
Click="DeleteItemButton_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" x:Name="TotalText" FontSize="22" FontWeight="Bold" 
HorizontalAlignment="Right" Margin="4,8" />
    </Grid>
</Page> 