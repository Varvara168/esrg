<Window x:Class="ChudoObuv.MainWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        Title="Чудо Обувь" 
        Icon="Resources\app.ico"
        Width="1100" Height="750" MinWidth="900" MinHeight="600" 
        WindowStartupLocation="CenterScreen" 
        FontFamily="Calibri" FontSize="16" 
        Background="{StaticResource MainBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            
        </Grid.RowDefinitions>

        <!-- Шапка: логотип, заголовок страницы, ФИО пользователя -->
        <Grid Grid.Row="0" Background="{StaticResource SecondaryBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Source="Resources/logo.png" Height="64" Margin="10,6" 
                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />

            <Button Grid.Column="1" x:Name="BackButton" Content="← Назад" VerticalAlignment="Center" 
                    Click="BackButton_Click" />

            <TextBlock Grid.Column="2" x:Name="PageTitleText" Text="Чудо Обувь" FontSize="26" 
FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="3" Orientation="Vertical" VerticalAlignment="Top" 
HorizontalAlignment="Right" Margin="10,6">
                <TextBlock x:Name="UserNameText" FontSize="18" FontWeight="Bold" 
HorizontalAlignment="Right" />
                <TextBlock x:Name="UserRoleText" FontSize="14" HorizontalAlignment="Right" />
                <Button x:Name="LogoutButton" Content="Выйти" HorizontalAlignment="Right" 
Click="LogoutButton_Click" />
            </StackPanel>
        </Grid>

        <Frame Grid.Row="1" x:Name="MainFrame" NavigationUIVisibility="Hidden" 
Navigated="MainFrame_Navigated" />
    </Grid>
</Window> 